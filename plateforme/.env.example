# Copie ce fichier en ".env" (sans ".example") et remplis les vraies valeurs.
# Ne jamais commiter le fichier ".env" réel — il contient des secrets.

# Chaîne de connexion Postgres (Supabase : Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Secret utilisé pour signer les cookies de session — mets n'importe quelle
# longue chaîne aléatoire (ex: génère-la avec `openssl rand -hex 32`).
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Optionnel — port d'écoute local (Render le définit automatiquement en production).
PORT=4321
